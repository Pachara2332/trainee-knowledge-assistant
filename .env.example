# --- Auth.js / NextAuth (จำเป็น) ---
# ใช้ค่าสุ่มยาว ๆ อย่างน้อย 32 ตัวอักษร (ไม่ใช้ค่า placeholder เช่น "xx")
# URL ที่ผู้ใช้เปิดเบราว์เซอร์จริง — ถ้า Docker map พอร์ตอื่น ให้ตั้งเป็นพอร์ตนั้น
# ทางเลือก: ถ้าไม่ตั้ง AUTH_URL ใน production ให้ใส่ true (โค้ดมี trustHost: true แล้วบางส่วนช่วยได้)
# AUTH_TRUST_HOST=true

NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql://admin:password@db:5432/knowledge_assistant
# Use redis://localhost:6379 when running Next outside Docker.
REDIS_URL=redis://redis:6379

# --- AI ---
GEMINI_API_KEY=

CHROMA_URL=http://chromadb:8000

OPENROUTER_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
